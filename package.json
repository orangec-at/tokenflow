{
  "name": "tokenflow",
  "version": "0.1.0",
  "description": "React hooks for streaming text UIs: per-frame token batching, scroll anchoring that respects the reader, and an SSE reader that survives chunk boundaries.",
  "keywords": [
    "react",
    "streaming",
    "sse",
    "llm",
    "chat",
    "hooks",
    "performance",
    "scroll",
    "typescript"
  ],
  "license": "MIT",
  "author": "Jaeil Lee <jaeil1117@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orangec-at/tokenflow.git"
  },
  "homepage": "https://github.com/orangec-at/tokenflow#readme",
  "bugs": {
    "url": "https://github.com/orangec-at/tokenflow/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
